# A game project on Recomp-Framework. Copy this folder, fill in game.c, then:
#   ln -s "/path/to/the/game/MyGame.exe" orig.exe
#   make gen && make app
FW        = ..
GAME_EXE  = orig.exe
APP_NAME  = MyGame
BUNDLE_ID = com.example.mygame-recomp
GAME_SRC  = game.c
NATIVE    = native.txt
PATCHES   = patches.txt
include $(FW)/recomp.mk
