diff --git a/include/native/wsi/native_host.h b/include/native/wsi/native_host.h
new file mode 100644
index 00000000..1e6b2ac8
--- /dev/null
+++ b/include/native/wsi/native_host.h
@@ -0,0 +1,31 @@
+// "Host" WSI for DXVK native: the embedding application owns its windows and hands DXVK a CAMetalLayer per HWND.
+// HWNDs are opaque handles chosen by the application. Select with DXVK_WSI_DRIVER=Host and register the callbacks
+// before the first Direct3DCreate9 / CreateDXGIFactory call.
+#pragma once
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct DxvkHostWsiCallbacks {
+    uint32_t version;   // 1
+    // client area size in pixels (the swap chain size when the game doesn't say)
+    void  (*get_window_size)(void *hwnd, uint32_t *width, uint32_t *height);
+    // the game resized its window (windowed mode); width/height in pixels
+    void  (*resize_window)(void *hwnd, uint32_t width, uint32_t height);
+    // the CAMetalLayer backing the window, for VK_EXT_metal_surface
+    void *(*get_metal_layer)(void *hwnd);
+    int   (*is_window)(void *hwnd);
+    int   (*is_minimized)(void *hwnd);
+    // the display: size in pixels and refresh rate in mHz
+    void  (*get_display)(uint32_t *width, uint32_t *height, uint32_t *refresh_mhz);
+    // fullscreen on/off for the window (a borderless desktop-sized window is fine)
+    int   (*set_fullscreen)(void *hwnd, int fullscreen);
+} DxvkHostWsiCallbacks;
+
+void dxvk_host_wsi_set_callbacks(const DxvkHostWsiCallbacks *callbacks);
+
+#ifdef __cplusplus
+}
+#endif
