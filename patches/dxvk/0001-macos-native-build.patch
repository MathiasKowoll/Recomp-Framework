diff --git a/src/wsi/host/wsi_platform_host.cpp b/src/wsi/host/wsi_platform_host.cpp
new file mode 100644
index 00000000..84ad00c1
--- /dev/null
+++ b/src/wsi/host/wsi_platform_host.cpp
@@ -0,0 +1,154 @@
+#if defined(DXVK_WSI_HOST)
+
+// Host WSI: windows belong to the embedding application (see include/native/wsi/native_host.h).
+#include "../wsi_platform.h"
+#include "../wsi_monitor.h"
+#include "../wsi_window.h"
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+#include "native/wsi/native_host.h"
+
+#include <windows.h>
+#include <cstring>
+#include <array>
+
+namespace dxvk::wsi {
+
+  static DxvkHostWsiCallbacks g_cb = {};
+  static const HMONITOR g_monitor = reinterpret_cast<HMONITOR>(uintptr_t(1));
+
+  // modes offered to the game: common sizes up to the display's, at its refresh rate
+  static const std::array<std::array<uint32_t, 2>, 14> g_sizes = {{
+    { 640, 480 }, { 800, 600 }, { 1024, 768 }, { 1280, 720 }, { 1280, 800 }, { 1280, 1024 }, { 1366, 768 },
+    { 1440, 900 }, { 1600, 900 }, { 1680, 1050 }, { 1920, 1080 }, { 1920, 1200 }, { 2560, 1440 }, { 3840, 2160 },
+  }};
+
+  class HostWsiDriver : public WsiDriver {
+    void display(uint32_t* w, uint32_t* h, uint32_t* mhz) {
+      *w = 1920; *h = 1080; *mhz = 60000;
+      if (g_cb.get_display) g_cb.get_display(w, h, mhz);
+    }
+    void fillMode(uint32_t w, uint32_t h, uint32_t mhz, WsiMode* m) {
+      m->width = w; m->height = h;
+      m->refreshRate = WsiRational { mhz, 1000 };
+      m->bitsPerPixel = 32;
+      m->interlaced = false;
+    }
+  public:
+    std::vector<const char *> getInstanceExtensions() {
+      return { VK_KHR_SURFACE_EXTENSION_NAME, "VK_EXT_metal_surface" };
+    }
+
+    HMONITOR getDefaultMonitor() { return g_monitor; }
+    HMONITOR enumMonitors(uint32_t index) { return index == 0 ? g_monitor : nullptr; }
+    HMONITOR enumMonitors(const LUID *adapterLUID[], uint32_t numLUIDs, uint32_t index) { return enumMonitors(index); }
+
+    bool getDisplayName(HMONITOR hMonitor, WCHAR (&Name)[32]) {
+      const char* n = "\\\\.\\DISPLAY1";
+      for (size_t i = 0; i < 32; i++) { Name[i] = WCHAR(n[i]); if (!n[i]) break; }
+      return true;
+    }
+
+    bool getDesktopCoordinates(HMONITOR hMonitor, RECT* pRect) {
+      uint32_t w, h, mhz; display(&w, &h, &mhz);
+      pRect->left = 0; pRect->top = 0; pRect->right = LONG(w); pRect->bottom = LONG(h);
+      return true;
+    }
+
+    bool getDisplayMode(HMONITOR hMonitor, uint32_t modeNumber, WsiMode* pMode) {
+      uint32_t w, h, mhz; display(&w, &h, &mhz);
+      uint32_t k = 0;
+      for (const auto& s : g_sizes) {
+        if (s[0] > w || s[1] > h || (s[0] == w && s[1] == h))
+          continue;
+        if (k++ == modeNumber) { fillMode(s[0], s[1], mhz, pMode); return true; }
+      }
+      if (k == modeNumber) { fillMode(w, h, mhz, pMode); return true; }   // the native mode last
+      return false;
+    }
+
+    bool getCurrentDisplayMode(HMONITOR hMonitor, WsiMode* pMode) {
+      uint32_t w, h, mhz; display(&w, &h, &mhz);
+      fillMode(w, h, mhz, pMode);
+      return true;
+    }
+
+    bool getDesktopDisplayMode(HMONITOR hMonitor, WsiMode* pMode) { return getCurrentDisplayMode(hMonitor, pMode); }
+
+    WsiEdidData getMonitorEdid(HMONITOR hMonitor) { return {}; }
+
+    void getWindowSize(HWND hWindow, uint32_t* pWidth, uint32_t* pHeight) {
+      uint32_t w = 0, h = 0;
+      if (g_cb.get_window_size) g_cb.get_window_size(hWindow, &w, &h);
+      if (pWidth) *pWidth = w;
+      if (pHeight) *pHeight = h;
+    }
+
+    void resizeWindow(HWND hWindow, DxvkWindowState* pState, uint32_t width, uint32_t height) {
+      if (g_cb.resize_window) g_cb.resize_window(hWindow, width, height);
+    }
+
+    void saveWindowState(HWND, DxvkWindowState*, bool) { }
+    void restoreWindowState(HWND, DxvkWindowState*, bool) { }
+
+    bool setWindowMode(HMONITOR hMonitor, HWND hWindow, DxvkWindowState* pState, const WsiMode& mode) {
+      if (g_cb.resize_window) g_cb.resize_window(hWindow, mode.width, mode.height);
+      return true;
+    }
+
+    bool enterFullscreenMode(HMONITOR hMonitor, HWND hWindow, DxvkWindowState* pState, bool modeSwitch) {
+      return g_cb.set_fullscreen ? g_cb.set_fullscreen(hWindow, 1) != 0 : true;
+    }
+
+    bool leaveFullscreenMode(HWND hWindow, DxvkWindowState* pState) {
+      return g_cb.set_fullscreen ? g_cb.set_fullscreen(hWindow, 0) != 0 : true;
+    }
+
+    bool restoreDisplayMode() { return true; }
+    HMONITOR getWindowMonitor(HWND hWindow) { return g_monitor; }
+    bool isWindow(HWND hWindow) { return g_cb.is_window ? g_cb.is_window(hWindow) != 0 : hWindow != nullptr; }
+    bool isMinimized(HWND hWindow) { return g_cb.is_minimized ? g_cb.is_minimized(hWindow) != 0 : false; }
+    bool isOccluded(HWND hWindow) { return false; }
+    void updateFullscreenWindow(HMONITOR, HWND, bool) { }
+
+    VkResult createSurface(HWND hWindow, PFN_vkGetInstanceProcAddr pfnVkGetInstanceProcAddr, VkInstance instance, VkSurfaceKHR* pSurface) {
+      void* layer = g_cb.get_metal_layer ? g_cb.get_metal_layer(hWindow) : nullptr;
+      if (!layer) {
+        Logger::err("Host WSI: no CAMetalLayer for the window");
+        return VK_ERROR_INITIALIZATION_FAILED;
+      }
+      // VK_EXT_metal_surface, declared here so the build needs no platform headers
+      struct MetalSurfaceCreateInfo { VkStructureType sType; const void* pNext; VkFlags flags; const void* pLayer; };
+      typedef VkResult (VKAPI_PTR *PFN_CreateMetalSurface)(VkInstance, const MetalSurfaceCreateInfo*, const VkAllocationCallbacks*, VkSurfaceKHR*);
+      auto create = reinterpret_cast<PFN_CreateMetalSurface>(pfnVkGetInstanceProcAddr(instance, "vkCreateMetalSurfaceEXT"));
+      if (!create) {
+        Logger::err("Host WSI: vkCreateMetalSurfaceEXT not available");
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+      }
+      MetalSurfaceCreateInfo info = { VkStructureType(1000217000), nullptr, 0, layer };   // VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT
+      return create(instance, &info, nullptr, pSurface);
+    }
+  };
+
+  static bool createHostDriver(WsiDriver **driver) {
+    if (!g_cb.version) {
+      Logger::err("Host WSI: dxvk_host_wsi_set_callbacks was not called");
+      return false;
+    }
+    *driver = new HostWsiDriver();
+    return true;
+  }
+
+  WsiBootstrap HostWSI = {
+    "Host",
+    createHostDriver
+  };
+
+}
+
+extern "C" __attribute__((visibility("default"))) void dxvk_host_wsi_set_callbacks(const DxvkHostWsiCallbacks* callbacks) {
+  if (callbacks)
+    dxvk::wsi::g_cb = *callbacks;
+}
+
+#endif
