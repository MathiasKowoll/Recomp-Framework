 }
@@ -125,6 +130,25 @@
    @autoreleasepool {
       id<MTL4CommandQueue> q = (id<MTL4CommandQueue>)queue;
       id<MTLDrawable> d = (id<MTLDrawable>)drawable;
-      [q signalDrawable:d];
+      if (!getenv("MESA_KK_LEGACY_PRESENT"))
+         [q signalDrawable:d];
+      /* MESA_KK_LEGACY_PRESENT: tools that draw over the game by hooking -[MTLCommandBuffer presentDrawable:]
+       * (the Steam overlay) never see Metal 4 presents, and the overlay can swap in a drawable texture this queue
+       * can't write (it isn't in the residency set). In this mode the queue renders the final blit into a
+       * texture of its own (kk_bind_drawable_to_vkimage) and records an event that fires when that is done;
+       * the WSI then copies it into the drawable and presents through a Metal 3 command buffer. */
+      if (getenv("MESA_KK_LEGACY_PRESENT")) {
+         static id<MTLSharedEvent> event;
+         static uint64_t value;
+         uint64_t v;
+         @synchronized ([MTLSharedEventListener class]) {
+            if (!event)
+               event = [q.device newSharedEvent];
+            v = ++value;
+         }
+         [q signalEvent:event value:v];
+         objc_setAssociatedObject(d, sel_registerName("mesaPresentEvent"), @[ event, @(v) ],
+                                  OBJC_ASSOCIATION_RETAIN);
+      }
    }
 }
