@@ -54,6 +54,21 @@ kk_bind_drawable_to_vkimage(VkImage vk_image, void *drawable)
    VK_FROM_HANDLE(kk_image, image, vk_image);
    mtl_texture *texture = mtl_drawable_get_texture(drawable);
 
+   if (getenv("MESA_KK_LEGACY_PRESENT")) {   /* see mtl_command_queue_signal_drawable */
+      struct kk_device *dev = container_of(image->vk.base.device, struct kk_device, vk);
+      if (!image->legacy_present_tex ||
