@@ -37,6 +37,11 @@
 #include "mtl_texture.h"
 
 mtl_texture *mtl_drawable_get_texture(void *drawable_ptr);
+/* MESA_KK_LEGACY_PRESENT: the texture the final blit renders into instead of the drawable's (see
+ * mtl_command_queue_signal_drawable), and the drawable's link to it for the WSI present. */
+mtl_texture *mtl_new_texture_like_drawable(mtl_device *dev, void *drawable_ptr);
+bool mtl_texture_matches_drawable(mtl_texture *tex, void *drawable_ptr);
+void mtl_drawable_set_present_source(void *drawable_ptr, mtl_texture *tex);
 
 void *mtl_retain(void *handle);
 void mtl_release(void *handle);
diff --git a/src/kosmickrisp/bridge/mtl_bridge.m b/src/kosmickrisp/bridge/mtl_bridge.m
index a5ef514..b30e4fe 100644
--- a/src/kosmickrisp/bridge/mtl_bridge.m
+++ b/src/kosmickrisp/bridge/mtl_bridge.m
@@ -4,6 +4,9 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include <objc/runtime.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
 #include "mtl_bridge.h"
 
 // kk_image_layout.h should also includes "vulkan/vulkan.h", but just to be safe
@@ -31,6 +34,34 @@
    }
 }
 
+mtl_texture *
+mtl_new_texture_like_drawable(mtl_device *dev, void *drawable_ptr)
+{
+   @autoreleasepool {
+      id<MTLTexture> t = ((id<CAMetalDrawable>)drawable_ptr).texture;
+      MTLTextureDescriptor *d =
+         [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:t.pixelFormat width:t.width height:t.height
+                                                        mipmapped:NO];
+      d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+      d.storageMode = MTLStorageModePrivate;
+      return [(id<MTLDevice>)dev newTextureWithDescriptor:d];
+   }
+}
+
+bool
+mtl_texture_matches_drawable(mtl_texture *tex, void *drawable_ptr)
+{
+   id<MTLTexture> a = (id<MTLTexture>)tex, b = ((id<CAMetalDrawable>)drawable_ptr).texture;
+   return a.width == b.width && a.height == b.height && a.pixelFormat == b.pixelFormat;
+}
+
+void
+mtl_drawable_set_present_source(void *drawable_ptr, mtl_texture *tex)
+{
+   objc_setAssociatedObject((id)drawable_ptr, sel_registerName("mesaPresentSource"), (id)tex,
+                            OBJC_ASSOCIATION_RETAIN);
+}
+
 void *
 mtl_retain(void *handle)
 {
