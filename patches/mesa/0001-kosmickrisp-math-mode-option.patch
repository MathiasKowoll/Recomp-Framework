+/* Recomp-Framework: the Metal math mode for compiled shaders. MESA_KK_MATH_MODE=fast|relaxed|safe sets it for all
+ * stages (default fast) and MESA_KK_VS_MATH_MODE for vertex shaders only. Games written for desktop drivers can
+ * rely on IEEE infinities (x / 0 = inf, saturate(inf) = 1), which fast math assumes never happen: id Tech 6's
+ * particle vertex shaders divide by zero for every particle with the default fade and lose the whole vertex. */
+static enum mtl_math_mode
+kk_parse_math_mode(const char *e, enum mtl_math_mode def)
+{
+   return e && !strcmp(e, "safe")      ? MTL_MATH_MODE_SAFE
+          : e && !strcmp(e, "relaxed") ? MTL_MATH_MODE_RELAXED
+          : e && !strcmp(e, "fast")    ? MTL_MATH_MODE_FAST
+                                       : def;
+}
+static enum mtl_math_mode
+kk_shader_math_mode(bool vertex)
+{
+   static int mode = -1, vs_mode = -1;
+   if (mode < 0) {
+      mode = kk_parse_math_mode(getenv("MESA_KK_MATH_MODE"), MTL_MATH_MODE_FAST);
+      vs_mode = kk_parse_math_mode(getenv("MESA_KK_VS_MATH_MODE"), (enum mtl_math_mode)mode);
+   }
+   return (enum mtl_math_mode)(vertex ? vs_mode : mode);
+}
+
 #include "nir_builder.h"
 #include "nir_lower_blend.h"
 
